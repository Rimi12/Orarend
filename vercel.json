{
  "cleanUrls": true,
  "functions": {
    "api/solve-timetable.py": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/sync.py": {
      "memory": 512,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/sync",
      "destination": "/api/sync.py"
    },
    {
      "source": "/api/solve-timetable",
      "destination": "/api/solve-timetable.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
